# === diy-photobook — .gitignore ===
# CRITICAL: never track image/video binaries or the working piles.
# The repo holds CODE + CONFIG + DOCS only. All photos live outside git.
# The demo's images, manifest, and book are GENERATED by `make demo` — never committed.

# --- Working piles (never committed) ---
staging/
review/
export/
export_book/
logs/
demo/_work/

# --- Generated books + manifests (regenerable; local-only) ---
book.json
manifest.db
manifest.db-journal
manifest.db-wal
manifest.db-shm
demo/manifest.db

# --- Image formats (ALL generated/user-supplied; none belong in git) ---
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.heic
*.heif
*.avif

# --- RAW formats ---
*.raw
*.dng
*.cr2
*.cr3
*.nef
*.arw
*.raf
*.orf
*.rw2
*.pef
*.srw

# --- Video formats ---
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.3gp
*.webm

# --- PDFs (proof/export outputs are generated) ---
*.pdf

# --- Sidecar / decisions artifacts (regenerable / user-downloaded) ---
decisions.json
*.decisions.json

# --- Python ---
.venv/
.venv312/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# --- Env / secrets ---
.env
.env.local

# --- Decontamination gate's private blocklist (personal data; local-only) ---
scrub_private_blocklist.txt

# --- OS cruft ---
Thumbs.db
.DS_Store
desktop.ini

# --- Editor previews + generated samples ---
samples/
